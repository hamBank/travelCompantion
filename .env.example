# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to a local SQLite file when unset. For Postgres, provision with
# scripts/provision_postgres.sh and set (note the +psycopg driver):
# DATABASE_URL=postgresql+psycopg://travelcomp:password@localhost/travelcomp

# ── Google OAuth ──────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (type: Web application)
# 4. Add Authorised JavaScript origins:
#      http://localhost:8000   (local dev via built frontend)
#      http://localhost:5173   (local dev via Vite dev server)
#      https://your-domain.com (production)
# 5. Copy the Client ID into both vars below.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Authentication switch. Must be set: the server refuses to start without it (and
# without a GOOGLE_CLIENT_ID), so auth can't be off by accident.
#   true   - production. Requires GOOGLE_CLIENT_ID and a private JWT_SECRET.
#   false  - local development only: every request is the dev user, no login.
AUTH_ENABLED=true

# Comma-separated emails that can sign in (the first is the original owner of
# pre-sharing trips). Leave blank to allow any Google account; people you share a
# trip with can always sign in. Replaces the old singular ALLOWED_EMAIL, which is
# still read (with a warning) while ALLOWED_EMAILS is unset.
ALLOWED_EMAILS=you@gmail.com
# DEPRECATED, use ALLOWED_EMAILS above:
# ALLOWED_EMAIL=

# Random secret used to sign session JWTs. With AUTH_ENABLED=true the server refuses
# to start while this is unset or the public default. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token lasts (days). Default: 30. The session slides: once a
# token is past halfway, the next request returns a fresh one (X-Refreshed-Token),
# so it only expires after this many days of the app not being used at all.
# JWT_EXPIRE_DAYS=30
# Lifetime of personal access tokens (days, the maximum a user can request). Default: 365.
# API_TOKEN_EXPIRE_DAYS=365

# ── Google Maps / Places ──────────────────────────────────────────────────────
# Places API key — used for the "Auto-fill" enrichment (address/phone/website).
# GOOGLE_PLACES_API_KEY=your-places-api-key

# Routes API key — used for "Calculate distance" (road/path distance + duration).
# Needs the Routes API enabled on this key. Falls back to GOOGLE_PLACES_API_KEY
# if left unset.
# GOOGLE_ROUTE_API_KEY=your-routes-api-key

# Static Maps key — used for the route-path map images (the backend proxies them so
# the key never reaches the browser). Falls back to GOOGLE_ROUTE_API_KEY, then
# GOOGLE_PLACES_API_KEY, if left unset.
# GOOGLE_STATIC_MAPS_API_KEY=your-static-maps-api-key

# Set to 1 to let the Google Sheets client open a browser for OAuth consent. Local
# development only: on a headless server it would hang. Default: off.
# SHEETS_ALLOW_INTERACTIVE=1

# ── AI document / email parsing ───────────────────────────────────────────────
# Anthropic API key. Unset = document upload and email ingestion report "parser
# not configured" instead of failing.
# ANTHROPIC_API_KEY=

# ── Document vault (encrypted passport/licence/visa scans) ─────────────────────
# Generate with: python scripts/gen_document_key.py
# CRITICAL: losing or rotating this key after any document is stored destroys
# every stored document irrecoverably — there is no reset path. Set it before
# first use and back it up somewhere durable outside this server (e.g. a
# password manager entry). Every /me/documents route 503s while this is unset.
# DOCUMENT_ENCRYPTION_KEY=

# ── Email ingestion (forward bookings to import+<token>@your-domain) ───────────
# Shared secret between postfix's mail_ingest.py pipe and POST /ingest/email.
# Must match on both sides. Generate with: openssl rand -hex 32
# MAIL_INGEST_SECRET=
# Domain used to build each user's forwarding address (import+<token>@MAIL_DOMAIN).
# MAIL_DOMAIN=tripplan.hups.club
# Where raw emails + attachments are stored (default: <app>/mail_store).
# MAIL_STORE_DIR=/opt/travelcomp/mail_store

# ── Server ────────────────────────────────────────────────────────────────────
# Directory for the rotating app.log (falls back to stderr if not writable).
# LOG_DIR=/var/log/travelcomp
# GitHub webhook auto-deploy secret (set the same value in the GitHub webhook).
# DEPLOY_SECRET=
# Public origin of this install, used to build the AeroDataBox webhook callback URL.
# PUBLIC_BASE_URL=https://your-domain.com

# ── Live flight alerts (AeroDataBox via RapidAPI) ─────────────────────────────
# The free tier is 600 units/month; see "Metered external APIs" in CLAUDE.md before
# changing any of the cadence settings below.
# AERODATABOX_KEY=
# Shared secret that authenticates AeroDataBox's webhook callbacks to us.
# AERODATABOX_WEBHOOK_SECRET=
# Keep the alert-credit balance at or above FLOOR; refill by REFILL when it dips below.
# REFILL is clamped to REFILL_MAX (the plan's per-call limit, 40 on the current plan).
# FLIGHT_ALERT_CREDIT_FLOOR=20
# FLIGHT_ALERT_CREDIT_REFILL=40
# FLIGHT_ALERT_CREDIT_REFILL_MAX=40
# Days a cached "does this airport have live updates" check is trusted.
# FLIGHT_ALERT_COVERAGE_RECHECK_DAYS=7
# Only poll flights departing within this many hours, at most once per POLL minutes.
# FLIGHT_ALERT_WINDOW_HOURS=24
# FLIGHT_ALERT_POLL_MINUTES=45
# Same for rail (transport.rest, unmetered).
# RAIL_ALERT_WINDOW_HOURS=24
# RAIL_ALERT_POLL_MINUTES=30

# ── Notifications / web push ──────────────────────────────────────────────────
# Generate once per install with: python scripts/gen_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=admin@tripplan.hups.club
# Hours before a departure to send the "time to leave" notification.
# DEPARTURE_LEAD_HOURS=3
